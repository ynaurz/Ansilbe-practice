server {
    listen 80 default_server;
    listen [::]:80 default_server;

    root /var/www/html;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    location /nginx_status {
        stub_status;
        allow 127.0.0.1;
        allow 172.30.0.13;
        deny all;
    }
}